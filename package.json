{
  "name": "starfighter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --dir src",
    "test:sim": "vitest run --dir tests/sim",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "prepare": "lefthook install",
    "board": "node scripts/board-sync.mjs",
    "audio:measure": "node scripts/audio-measure.mjs",
    "style:contrast": "node scripts/contrast-audit.mjs",
    "style:sheet": "node scripts/style-sheet.mjs",
    "style:frame-time": "node scripts/frame-time.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "lefthook": "^2.1.16",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
